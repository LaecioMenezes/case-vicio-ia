# Copie para .env e preencha. O .env NÃO vai para o git.
# Modelos: o Jev (TypeSafe), que decide, pelo OpenRouter ou por um backend próprio, e o revisor automático
# (LLM barato, pelo OpenRouter; o modelo fica em config/politica.json, revisor_llm.modelo).
# A chave só é necessária para chamadas novas: as respostas usadas estão em cache/.
OPENROUTER_API_KEY=
# "openrouter" (padrão) ou "backend" (servidor local do Jev; se não responder, cai para o OpenRouter)
JEV_PROVIDER=openrouter
JEV_MODEL_OPENROUTER=typesafe/jev-1.13-20260917
JEV_BASE_URL=http://localhost:3010
JEV_PATH=/api/v1/decisions
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
